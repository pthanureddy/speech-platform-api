{
  "name": "speech-platform-api",
  "version": "1.0.0",
  "private": true,
  "description": "A production-shaped TypeScript control-plane API for deterministic speech jobs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/verify-integration-env.mjs && vitest run test/postgres-platform-repository.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google-cloud/storage": "^8.0.1",
    "fastify": "^5.12.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
