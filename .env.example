NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Optional in development; required in production. When omitted, the API uses
# the deterministic in-memory repository.
# DATABASE_URL=postgresql://speech_platform:password@127.0.0.1:5432/speech_platform
DEMO_TENANT_ID=tenant_demo
DEMO_TENANT_NAME=Demo tenant
DEMO_PLAN=starter
DEMO_API_KEY=dev_demo_key_change_me
INTERNAL_TOKEN=dev_internal_token_change_me
WEBHOOK_SECRET=dev_webhook_secret_change_me
WEBHOOK_TOLERANCE_SECONDS=300
